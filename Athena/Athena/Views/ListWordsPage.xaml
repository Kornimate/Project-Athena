<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Athena.Views.ListWordsPage"
             Title="List Words"
             xmlns:vm="clr-namespace:Athena.ViewModels"
             x:DataType="vm:ListWordsViewModel"
			 xmlns:models="clr-namespace:Athena.Models">

    <ContentPage.Content>
        <Grid Padding="10">
            <CollectionView
				ItemsSource="{Binding Words}"
				SelectionMode="Single"
				SelectedItem="{Binding SelectedWord, Mode=TwoWay}"
                VerticalScrollBarVisibility="Default">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WordModel">
                        <Grid Padding="10" ColumnDefinitions="*,*,*">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    NumberOfTapsRequired="2"
                                    Command="{Binding BindingContext.RemoveWordCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                                <TapGestureRecognizer
                                    NumberOfTapsRequired="1"
                                    Command="{Binding BindingContext.SelectWordCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding GreekInGreek}" Grid.Column="0" />
                            <Label Text="{Binding GreekInLatin}" Grid.Column="1" />
                            <Label Text="{Binding EnglishTranslation}" Grid.Column="2" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
